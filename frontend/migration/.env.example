# Firebase Admin SDK service account JSON file path
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# PostgreSQL connection (new backend database)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hunger_connect
PG_USER=postgres
PG_PASSWORD=postgres

# Backend API base URL (used to force-trigger password resets)
API_BASE_URL=http://localhost:8080

# Set to true to only log what would be migrated without writing
DRY_RUN=false
